#!/usr/bin/env php
<?php

declare(strict_types=1);

use Copot\Core\Env;
use Copot\Core\DeploymentContext;
use Copot\Core\PackageLifecycleFactory;
use Copot\Core\BackupRecovery\InstallationScopedMaintenanceGuard;
use Copot\Core\InstallationMutex;

$defaultAppRoot = dirname(__DIR__);
$configuredAppRoot = getenv('COPOT_APP_ROOT');
$autoloadRoot = is_string($configuredAppRoot) && trim($configuredAppRoot) !== '' ? trim($configuredAppRoot) : $defaultAppRoot;
$resolvedAutoloadRoot = realpath($autoloadRoot);
if ($resolvedAutoloadRoot === false || is_link($autoloadRoot) || !is_dir($resolvedAutoloadRoot) || !is_readable($resolvedAutoloadRoot)) {
    fwrite(STDERR, "unavailable: Configured APP_ROOT is invalid.\n");
    exit(7);
}
$autoloadPath = $resolvedAutoloadRoot . DIRECTORY_SEPARATOR . 'bootstrap' . DIRECTORY_SEPARATOR . 'autoload.php';
if (!is_file($autoloadPath) || !is_readable($autoloadPath)) {
    fwrite(STDERR, "unavailable: Application autoload target is invalid.\n");
    exit(7);
}
$autoloadRoot = $resolvedAutoloadRoot;
require $autoloadPath;

function usage(): void
{
    fwrite(STDERR, "Usage: bin/copot package:(plan|reconcile-plan|reconcile|apply|repair|adopt) <zip> [--confirm] [--confirmation-json=<object>] [--format=human|json]\n       bin/copot package:status [--format=human|json]\n");
}

function emit(array $data, string $format, int $code): never
{
    if ($format === 'json') {
        echo json_encode($data, JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR) . PHP_EOL;
    } else {
        echo ($data['status'] ?? 'unknown') . ': ' . ($data['reason'] ?? '') . PHP_EOL;
        if (isset($data['classification']) && $data['classification'] !== null) { echo 'classification: ' . $data['classification'] . PHP_EOL; }
    }
    exit($code);
}

$args = array_slice($argv, 1);
if ($args === [] || in_array($args[0], ['--help', '-h'], true)) { usage(); exit(2); }
$command = array_shift($args);
$format = 'human';
$confirmed = false;
$confirmation = null;
foreach ($args as $key => $arg) {
    if (str_starts_with($arg, '--format=')) { $format = substr($arg, 9); unset($args[$key]); continue; }
    if ($arg === '--confirm') { $confirmed = true; unset($args[$key]); continue; }
    if (str_starts_with($arg, '--confirmation-json=')) {
        $raw = substr($arg, 20);
        try { $confirmation = json_decode($raw, true, 32, JSON_THROW_ON_ERROR); } catch (Throwable) { emit(['accepted' => false, 'status' => 'invalid_input', 'reason' => 'Typed destructive confirmation JSON is invalid.'], $format, 2); }
        if (!is_array($confirmation)) emit(['accepted' => false, 'status' => 'invalid_input', 'reason' => 'Typed destructive confirmation must be an object.'], $format, 2);
        unset($args[$key]); continue;
    }
    if (str_starts_with($arg, '--')) { usage(); exit(2); }
}
if (!in_array($format, ['human', 'json'], true)) { usage(); exit(2); }
$args = array_values($args);
$needsZip = in_array($command, ['package:plan', 'package:reconcile-plan', 'package:reconcile', 'package:apply', 'package:repair', 'package:adopt'], true);
if (!in_array($command, ['package:plan', 'package:reconcile-plan', 'package:reconcile', 'package:apply', 'package:repair', 'package:adopt', 'package:status'], true) || count($args) !== ($needsZip ? 1 : 0)) { usage(); exit(2); }
if ($needsZip && (!is_file($args[0]) || is_link($args[0]) || !is_readable($args[0]))) {
    emit(['accepted' => false, 'status' => 'invalid_input', 'reason' => 'Local package ZIP path is invalid.'], $format, 2);
}

try {
    Env::load($autoloadRoot . DIRECTORY_SEPARATOR . '.env');
    $cliLease = null;
    if (in_array($command, ['package:reconcile', 'package:adopt', 'package:apply', 'package:repair'], true)) {
        $cliGuard = new InstallationScopedMaintenanceGuard(new InstallationMutex($autoloadRoot . DIRECTORY_SEPARATOR . 'storage'), $autoloadRoot . DIRECTORY_SEPARATOR . 'storage');
        $cliLease = $cliGuard->admit('cli');
        if ($cliLease === null) { emit(['accepted' => false, 'status' => 'blocked', 'reason' => 'Installation-scoped maintenance is active.'], $format, 7); }
        register_shutdown_function(static function () use ($cliLease): void { $cliLease?->release(); });
    }
    $deploymentContext = DeploymentContext::forCli($defaultAppRoot);
    $service = PackageLifecycleFactory::forProject($deploymentContext);
    if ($command === 'package:status') {
        $status = $service->status();
        emit($status, $format, $status['accepted'] ? 0 : 5);
    }
    $result = match ($command) {
        'package:plan' => $service->plan($args[0]),
        'package:reconcile-plan' => $service->reconcilePlan($args[0]),
        'package:reconcile' => $service->reconcile($args[0], $confirmed),
        'package:adopt' => $service->adopt($args[0]),
        default => $service->apply($args[0], $command === 'package:repair', $confirmation),
    };
    $data = $result->toArray();
    emit($data, $format, $result->exitCode());
} catch (InvalidArgumentException $exception) {
    emit(['accepted' => false, 'status' => 'invalid_input', 'reason' => $exception->getMessage()], $format, 2);
} catch (RuntimeException $exception) {
    emit(['accepted' => false, 'status' => 'unavailable', 'reason' => $exception->getMessage()], $format, 7);
} catch (Throwable $exception) {
    emit(['accepted' => false, 'status' => 'failed', 'reason' => 'Unexpected lifecycle failure.'], $format, 8);
}
