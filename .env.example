# Configuration reference for supported environment overrides.
# The installer writes only the DB_* keys to .env. Add other values as needed.

APP_NAME=Copot
APP_ENV=local

# Required only for explicitly authorized Existing-Runtime Webcore reconciliation.
COPOT_RECOVERY_ROOT=""
COPOT_MARIADB_ADMIN_USERNAME=""
COPOT_MARIADB_ADMIN_PASSWORD=""
COPOT_MARIADB_QUIESCENCE_CONFIRMED=false
# Local development uses a 30-day session lifetime; non-local environments default to 120 minutes.
APP_DEBUG=true
APP_URL=http://localhost
SESSION_SECURE=false

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=copot
DB_USERNAME=root
DB_PASSWORD=
